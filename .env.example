# pihumtemp configuration. install.sh copies this to /etc/default/pihumtemp,
# which the systemd unit loads. All settings are optional.

# HTTP port; the server binds 0.0.0.0 so both the LAN and tailscale0 can reach it.
PORT=8080

# SQLite database (WAL mode). Default: /var/lib/pihumtemp/pihumtemp.db
# (or ./data/simulate.db with --simulate).
DB_PATH=/var/lib/pihumtemp/pihumtemp.db

# Which sensors to record, and their rooms. Entries are separated by ";" (or ","
# or newlines), each <MAC or BLE name>[=<room>]. The first one is the primary:
# API calls without ?sensor= use it. Find addresses with --debug, or in the
# "nearby" list of GET /api/sensors. Don't use ; or , inside room names.
# SENSORS=A4:C1:38:12:34:56=Living room;A4:C1:38:AB:CD:EF=Bedroom;GVH5075_9A2F=Office
#
# If SENSORS is unset, the sensors already in the database keep being recorded;
# with an empty database the first GVH5075_* heard is adopted.
# (SENSOR_ADDRESS / SENSOR_NAME still work for a single sensor, without a room.)

# debug | info | warn | error
LOG_LEVEL=info

# Every decoded advertisement (~every 2 s) is stored with its exact timestamp,
# about 410 MB per sensor per year. Delete raw samples older than this many days; 0 keeps
# them forever. The per-minute rows are always kept.
RAW_RETENTION_DAYS=0

# Development only: fake advertisements instead of Bluetooth (same as --simulate),
# how many fake sensors (rooms) to generate, and how many days of fake history
# to seed for each sensor that has none.
# SIMULATE=1
# SIMULATE_SENSORS=3
# SIMULATE_BACKFILL_DAYS=30
